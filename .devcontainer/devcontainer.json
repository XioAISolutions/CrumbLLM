{
  "name": "CrumbContext Launch Lab",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python -m pip install -e . && python -m pip install -e 'incubator/crumbcontext[dev]'",
  "postStartCommand": "printf '\nRun: crumbcontext benchmark --out proof --open\n'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}
