{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xioai.co/schemas/eja-experiment-v1.schema.json",
  "title": "CRUMB EJA Experiment v1",
  "type": "object",
  "required": [
    "eja_schema_version",
    "artifact_type",
    "experiment",
    "experience",
    "surprise",
    "hypotheses",
    "trajectories",
    "candidate_axiom",
    "verification",
    "provenance"
  ],
  "properties": {
    "eja_schema_version": {"const": "1.5"},
    "artifact_type": {"const": "eja_experiment"},
    "experiment": {
      "type": "object",
      "required": ["id", "world", "deterministic_seed"]
    },
    "blind_protocol": {
      "type": "object",
      "properties": {
        "protocol": {"type": "string"},
        "open_ended_abduction": {"const": false},
        "model_statements_visible_to_agent": {"const": false},
        "target_terms_withheld": {
          "type": "array",
          "items": {"type": "string"}
        },
        "leakage_hits": {
          "type": "array",
          "maxItems": 0,
          "items": {"type": "string"}
        },
        "mapping_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "agent_prompt_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "reveal_policy": {"type": "string"}
      }
    },
    "challenge_protocol": {
      "type": "object",
      "required": [
        "protocol",
        "case_commitment_hash",
        "answer_commitment_hash",
        "submission_hash",
        "answer_visible_to_agent",
        "case_spec_visible_to_agent",
        "selection_rule",
        "reveal_policy"
      ],
      "properties": {
        "protocol": {"const": "sealed_none_of_the_above_challenge_v1"},
        "case_commitment_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "answer_commitment_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "submission_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "answer_visible_to_agent": {"const": false},
        "case_spec_visible_to_agent": {"const": false},
        "selection_rule": {
          "type": "object",
          "required": [
            "minimum_score",
            "minimum_margin",
            "evidence_gates_required",
            "abstention_allowed"
          ],
          "properties": {
            "minimum_score": {"type": "number", "minimum": 0, "maximum": 1},
            "minimum_margin": {"type": "number", "minimum": 0, "maximum": 1},
            "evidence_gates_required": {"const": true},
            "abstention_allowed": {"const": true}
          }
        },
        "reveal_policy": {"type": "string"}
      }
    },
    "challenge_evaluation": {
      "type": "object",
      "required": [
        "hidden_case_spec",
        "answer_payload",
        "submission_payload",
        "selected_outcome",
        "abstained",
        "correct",
        "false_discovery",
        "positive_abstention"
      ],
      "properties": {
        "hidden_case_spec": {"type": "object"},
        "answer_payload": {
          "type": "object",
          "required": ["expected_outcome", "answerable_by_registered_deck"]
        },
        "submission_payload": {
          "type": "object",
          "required": [
            "challenge_id",
            "selected_outcome",
            "abstained",
            "top_score",
            "selection_margin",
            "evidence_refs"
          ]
        },
        "selected_outcome": {"type": "string"},
        "abstained": {"type": "boolean"},
        "correct": {"type": "boolean"},
        "false_discovery": {"type": "boolean"},
        "positive_abstention": {"type": "boolean"}
      }
    },
    "calibration_protocol": {
      "type": "object",
      "required": [
        "protocol",
        "split",
        "threshold_frozen_before_test",
        "threshold_commitment_hash",
        "frozen_threshold",
        "calibration_record_hashes",
        "test_answers_used_for_calibration"
      ],
      "properties": {
        "protocol": {"const": "disjoint_frozen_threshold_calibration_v1"},
        "split": {"enum": ["calibration", "test"]},
        "threshold_frozen_before_test": {"type": "boolean"},
        "threshold_commitment_hash": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "frozen_threshold": {
          "type": ["object", "null"],
          "properties": {
            "minimum_score": {"type": "number", "minimum": 0, "maximum": 1},
            "minimum_margin": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "calibration_record_hashes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "test_answers_used_for_calibration": {"const": false}
      }
    },
    "experience": {
      "type": "object",
      "required": ["initial_observations"]
    },
    "surprise": {
      "type": "object",
      "required": ["type", "description"]
    },
    "hypotheses": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "class", "statement", "assumptions", "falsifiers"],
        "properties": {
          "evidence_for": {
            "type": "array",
            "items": {"type": "string"}
          },
          "evidence_against": {
            "type": "array",
            "items": {"type": "string"}
          },
          "statement_visible_to_agent": {"type": "boolean"},
          "semantic_key": {"type": "string"}
        }
      }
    },
    "trajectories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["intervention", "observations"],
        "properties": {
          "evidence_ref": {"type": "string", "minLength": 1},
          "observed_signature": {"type": "string"}
        }
      }
    },
    "candidate_axiom": {
      "type": ["object", "null"],
      "required": ["id", "statement", "assumptions", "falsifiers", "excluded_claims"]
    },
    "deductions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_refs": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "required": ["verdict"]
    },
    "metrics": {
      "type": "object",
      "properties": {
        "discovery_complete": {"type": "boolean"},
        "experiments_run": {"type": "integer", "minimum": 0},
        "local_invariance_tests": {"type": "integer", "minimum": 0},
        "discriminating_tests": {"type": "integer", "minimum": 0},
        "scope_boundary_observed": {"type": "boolean"},
        "latent_difference_observed": {"type": "boolean"},
        "winner": {"type": "string"},
        "winner_score": {"type": "number", "minimum": 0, "maximum": 1},
        "blind_selection_correct": {"type": "boolean"},
        "evaluator_selected_semantic_key": {"type": "string"},
        "challenge_case_kind": {"type": "string"},
        "challenge_correct": {"type": "boolean"},
        "abstained": {"type": "boolean"},
        "selection_margin": {"type": "number"},
        "selected_outcome": {"type": "string"},
        "false_discovery": {"type": "boolean"}
      }
    },
    "salience_memory": {
      "type": "object",
      "properties": {
        "before": {"type": "object"},
        "after": {"type": "object"}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["artifact_hash", "hidden_state_exposed_to_agent"],
      "properties": {
        "artifact_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "hidden_state_exposed_to_agent": {"const": false},
        "hypothesis_origin": {"type": "string"},
        "challenge_case_commitment": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "challenge_answer_commitment": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "parent_artifact_hashes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
